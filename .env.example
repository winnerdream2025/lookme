# ─────────────────────────────────────────────────────────────────
# LookMe — Environment Variables
# Copy this file to .env and fill in ALL values before running.
# NEVER commit .env to version control.
# Generate secrets with: openssl rand -hex 64
# ─────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────
# Set to "production" on your server
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────
# Your managed PostgreSQL connection string (Neon, Supabase, RDS, etc.)
# The user said they'll provide the database — replace this URL entirely.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lookme?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────
# Managed Redis (Upstash, ElastiCache, Redis Cloud, etc.)
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# ── JWT ───────────────────────────────────────────────────────────
# REQUIRED — must be 64+ random characters, different per secret
# Generate: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Service Ports ─────────────────────────────────────────────────
# Change only if the defaults conflict with your host
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=5001
CATALOG_SERVICE_PORT=5002
ORDER_SERVICE_PORT=5003
TASK_SERVICE_PORT=5004
WALLET_SERVICE_PORT=5005

# ── Docker Service Hostnames ──────────────────────────────────────
# LOCAL DEV: leave as "localhost"
# DOCKER COMPOSE: set to the docker-compose service names below
AUTH_SERVICE_HOST=auth-service
CATALOG_SERVICE_HOST=catalog-service
ORDER_SERVICE_HOST=order-service
TASK_SERVICE_HOST=task-service
WALLET_SERVICE_HOST=wallet-service

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your frontend domains)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── App URLs ──────────────────────────────────────────────────────
# Public URL of your frontend (used in password-reset emails, etc.)
FRONTEND_URL=https://yourdomain.com
# Admin email for contact-form notifications
ADMIN_EMAIL=admin@yourdomain.com

# ── SMTP / Email ──────────────────────────────────────────────────
# Without these, emails are only logged to console (dev behaviour)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# ── AWS S3 (screenshot uploads) ───────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_BUCKET_NAME=lookme-proofs-prod
S3_PREFIX=proofs/
# Optional: CloudFront CDN URL in front of S3 (recommended for production)
CLOUDFRONT_URL=https://dXXXXXXXXXXXX.cloudfront.net

# ── Platform Business Rules ───────────────────────────────────────
PLATFORM_FEE_PERCENT=15
MIN_DEPOSIT=5
MIN_WITHDRAWAL=10

# ── Frontend (Next.js) ────────────────────────────────────────────
# These are baked into the client bundle at BUILD TIME.
# For Docker: pass as --build-arg in docker-compose.production.yml
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_...
