{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@lookme/database": ["./packages/database/src"],
      "@lookme/types": ["./packages/types/src"],
      "@lookme/validation": ["./packages/validation/src"],
      "@lookme/config": ["./packages/config/src"],
      "@lookme/utils": ["./packages/utils/src"],
      "@lookme/logger": ["./packages/logger/src"],
      "@lookme/server": ["./packages/server/src"],
      "@lookme/ui": ["./packages/ui/src"],
      "@lookme/email": ["./packages/email/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
